{
  "name": "glicoai",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "qa:release": "npm run typecheck && npm run doctor",
    "export:web": "npx expo export -p web",
    "postexport:web": "node scripts/prepare-web-pwa.js",
    "preview:web": "npx serve dist",
    "build:web": "npx expo export -p web",
    "postbuild:web": "node scripts/prepare-web-pwa.js",
    "build:android": "eas build -p android --profile production",
    "submit:android": "eas submit -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.3",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "supabase": "^2.98.2",
    "typescript": "~5.9.2"
  }
}
